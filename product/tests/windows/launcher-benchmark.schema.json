{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "trial", "measurementKind", "commitSha", "runner", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "trial": { "type": "integer", "minimum": 1, "maximum": 3 },
    "measurementKind": { "const": "hosted-runner-process-start" },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "cpu"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 }
      }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go", "dotnet"],
      "properties": {
        "go": { "$ref": "#/$defs/candidate" },
        "dotnet": { "$ref": "#/$defs/candidate" }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exeBytes", "buildMs", "p50Ms", "p95Ms", "mandatoryPassed", "cases", "toolchainVersion"],
      "allOf": [
        {
          "if": { "properties": { "mandatoryPassed": { "const": true } } },
          "then": {
            "properties": {
              "cases": { "type": "object", "additionalProperties": { "const": true } }
            }
          }
        },
        {
          "if": { "properties": { "mandatoryPassed": { "const": false } } },
          "then": {
            "not": {
              "properties": {
                "cases": { "type": "object", "additionalProperties": { "const": true } }
              }
            }
          }
        }
      ],
      "properties": {
        "exeBytes": { "type": "integer", "minimum": 1 },
        "buildMs": { "type": "number", "minimum": 0 },
        "p50Ms": { "type": "number", "minimum": 0 },
        "p95Ms": { "type": "number", "minimum": 0 },
        "mandatoryPassed": { "type": "boolean" },
        "cases": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 8,
          "maxProperties": 8,
          "required": [
            "valid-manifest",
            "invalid-sha256",
            "path-traversal",
            "absolute-path",
            "absolute-path-unc",
            "unicode-space-path",
            "sdk-path-removed",
            "cli-invalid-arguments"
          ],
          "properties": {
            "valid-manifest": { "type": "boolean" },
            "invalid-sha256": { "type": "boolean" },
            "path-traversal": { "type": "boolean" },
            "absolute-path": { "type": "boolean" },
            "absolute-path-unc": { "type": "boolean" },
            "unicode-space-path": { "type": "boolean" },
            "sdk-path-removed": { "type": "boolean" },
            "cli-invalid-arguments": { "type": "boolean" }
          }
        },
        "toolchainVersion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
