{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "action",
    "status",
    "startedAtUtc",
    "completedAtUtc",
    "machineIdSha256",
    "driveRoot",
    "physicalUsbVerified",
    "assertions",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "const": "portable-continuity" },
    "action": { "enum": ["Capture", "DeleteCache", "VerifyCacheRecovery", "Verify"] },
    "status": { "enum": ["passed", "needs-input", "failed"] },
    "startedAtUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "completedAtUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "machineIdSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "driveRoot": { "type": ["string", "null"], "pattern": "^[A-Za-z]:\\\\$" },
    "physicalUsbVerified": { "type": "boolean" },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "actual"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "actual": { "type": "string" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
