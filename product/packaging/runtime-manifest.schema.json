{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productVersion",
    "nodeVersion",
    "electronVersion",
    "runtimeVersion",
    "runtimeId",
    "targetPlatform",
    "targetArch",
    "runtimeArchive",
    "runtimeSha256",
    "runtimeTreeSha256",
    "runtimeBytes",
    "unpackedBytes",
    "fileCount",
    "entrypoint",
    "entryArgs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "nodeVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "electronVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "runtimeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "targetPlatform": { "const": "win32" },
    "targetArch": { "const": "x64" },
    "runtimeArchive": { "type": "string", "minLength": 1, "maxLength": 32767 },
    "runtimeSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "runtimeTreeSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "runtimeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "unpackedBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fileCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "entrypoint": { "type": "string", "minLength": 1, "maxLength": 32767 },
    "entryArgs": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "signedAt", "expiresAt", "sequence", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "signedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "value": { "type": "string", "minLength": 86, "maxLength": 88 }
      }
    }
  }
}
