# Production activation-server configuration.
# Inject secrets through the platform secret store. Never put private key
# material, PEM blocks, base64 private keys, or *_PRIVATE_KEY* variables here.

LISTEN_ADDRESS=:8080
DATABASE_URL=postgres://activation-service@postgres.example/activation
ACTIVATION_PEPPER_FILE=/run/secrets/activation-pepper
ADMIN_OPERATORS_FILE=/run/secrets/admin-operators.json
ADMIN_SECRET_FINGERPRINT_KEY_FILE=/run/secrets/admin-secret-fingerprint-key
NEW_API_ALLOWED_HOSTS=api.models.example

# Current runnable production baseline: secrets are injected as read-only files.
# Replace local-kek-v1 only after a provider-specific ManagedKMS adapter is selected,
# implemented, and granted least-privilege IAM. Never inline file contents here.
LICENSE_SIGNING_KEY_FILE=/run/secrets/license-signing-key
STATUS_SIGNING_KEY_FILE=/run/secrets/status-signing-key
PUBLIC_MODEL_ENDPOINT=https://license.yiyong.me/model-api/
KMS_KEK_FILE=/run/secrets/artifact-kek
LICENSE_KEY_ID=license-2026-01
STATUS_KEY_ID=status-2026-01
KMS_PROVIDER=local-kek-v1
KMS_KEY_VERSION=artifact-kek-2026-01

# Future provider adapter configuration must keep each purpose on a different
# managed key resource and pin immutable versions; never use latest aliases.
# LICENSE_KMS_KEY_RESOURCE=<provider-specific-resource>
# LICENSE_KMS_KEY_VERSION=<immutable-version>
# TOKEN_KMS_KEY_RESOURCE=<provider-specific-resource>
# TOKEN_KMS_KEY_VERSION=<immutable-version>
# RELEASE_KMS_KEY_RESOURCE=<separate-provider-specific-resource>
# RELEASE_KMS_KEY_VERSION=<immutable-version>

# Verification bundles contain public keys only. During rotation they contain
# both current and next versions.
LICENSE_PUBLIC_KEYS_FILE=/etc/u-claw/keys/license-public-keys.json
RELEASE_PUBLIC_KEYS_FILE=/etc/u-claw/keys/release-public-keys.json
