{
  "name": "uclaw-product",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.15.0"
  },
  "workspaces": [
    "shared",
    "adapter",
    "desktop",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run smoke:dist",
    "smoke:dist": "node shared/dist/index.js && node adapter/dist/index.js && node desktop/dist/index.js",
    "test": "node --test scripts/workspace.test.mjs && npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
