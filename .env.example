# Bavi-box 本地联调配置模板。
# 只将真实值填入根目录 .env；.env 已被 Git 忽略，禁止提交密钥。

# 可选：测试时注入的 Desktop wiring 模块绝对路径；正常本地和正式启动留空。
UCLAW_DESKTOP_WIRING_MODULE=

# 必填（真实 Electron）：Bavi-box runtime 根目录绝对路径，内含 OpenClaw 和内置 Node.js。
UCLAW_RUNTIME_DIR=
# 必填（真实 Electron）：U 盘或本地模拟 U 盘的权威数据目录绝对路径。
UCLAW_DATA_DIR=
# 必填（真实 Electron）：可重建的本机 runtime 缓存目录绝对路径。
UCLAW_CACHE_DIR=

# 可选：Vite 开发服务地址；正式打包不使用。
UCLAW_RENDERER_URL=http://127.0.0.1:4174

# 可选：Plugin 目录 API 根地址；首版已隐藏 Plugin 管理，非专项联调留空。
UCLAW_PLUGIN_REGISTRY_URL=

# 可选：HTTP 请求代理，格式如 http://127.0.0.1:7890；不需要则留空。
HTTP_PROXY=
# 可选：HTTPS 请求代理，格式如 http://127.0.0.1:7890；不需要则留空。
HTTPS_PROXY=
# 可选：不经代理的主机/域名，逗号分隔；本机地址必须保留。
NO_PROXY=127.0.0.1,localhost

# 以下 UCLAW_TEST_* 只用于开发联调与验收 harness。

# 可选：已运行 OpenClaw Gateway WebSocket 地址，格式如 ws://127.0.0.1:18789。
UCLAW_TEST_OPENCLAW_GATEWAY_URL=
# 可选/敏感：上述 Gateway 的鉴权 Token；仅填本地或专用测试凭据。
UCLAW_TEST_OPENCLAW_GATEWAY_TOKEN=
# 可选：OpenClaw CLI 入口文件绝对路径，例如 /path/to/openclaw.mjs。
UCLAW_TEST_OPENCLAW_CLI_PATH=

# 必填（本次真实对话联调）：OpenAI-compatible/New API 根地址，建议以 /v1 结尾。
UCLAW_TEST_PROVIDER_BASE_URL=
# 必填（本次真实对话联调）/敏感：模型调用 Token，不是 New API 后台管理 Key。
UCLAW_TEST_PROVIDER_API_KEY=
# 可选：首版固定为 gpt-5.6-sol；留空时自动使用该模型。
UCLAW_TEST_PROVIDER_MODEL=

# 可选：Ollama OpenAI-compatible 地址；默认本机 11434 端口。
UCLAW_TEST_OLLAMA_URL=http://127.0.0.1:11434
# 可选：LM Studio OpenAI-compatible 地址；默认本机 1234 端口。
UCLAW_TEST_LM_STUDIO_URL=http://127.0.0.1:1234

# 可选：旧 SkillHub API 联调地址；不代表腾讯 SkillHub 网站。
UCLAW_TEST_SKILLHUB_URL=https://skillhub.cn
# 可选：Plugin 目录测试地址；首版隐藏后通常留空。
UCLAW_TEST_PLUGIN_REGISTRY_URL=
# 可选：MCP Streamable HTTP/SSE 测试端点；首版隐藏后通常留空。
UCLAW_TEST_MCP_HTTP_URL=

# 可选/敏感：Telegram 专用测试 Bot Token。
UCLAW_TEST_TELEGRAM_BOT_TOKEN=
# 可选：Telegram 专用测试会话 ID。
UCLAW_TEST_TELEGRAM_CHAT_ID=
# 可选：QQ Bot 专用测试 App ID。
UCLAW_TEST_QQ_APP_ID=
# 可选/敏感：QQ Bot 专用测试 App Secret。
UCLAW_TEST_QQ_APP_SECRET=
# 可选：飞书专用测试 App ID。
UCLAW_TEST_FEISHU_APP_ID=
# 可选/敏感：飞书专用测试 App Secret。
UCLAW_TEST_FEISHU_APP_SECRET=
# 可选：企业微信专用测试 Corp ID。
UCLAW_TEST_WECOM_CORP_ID=
# 可选：企业微信应用 Agent ID。
UCLAW_TEST_WECOM_AGENT_ID=
# 可选/敏感：企业微信应用 Secret。
UCLAW_TEST_WECOM_SECRET=
# 可选/敏感：Discord 专用测试 Bot Token。
UCLAW_TEST_DISCORD_BOT_TOKEN=
# 可选：Discord 专用测试频道 ID。
UCLAW_TEST_DISCORD_CHANNEL_ID=

# 可选：New API 管理端 API 地址；自动开户暂缓时留空。
UCLAW_TEST_NEW_API_MANAGEMENT_URL=
# 可选：New API 数据/用量 API 地址；自动开户暂缓时留空。
UCLAW_TEST_NEW_API_DATA_URL=
# 可选：New API 测试用户名；自动开户暂缓时留空。
UCLAW_TEST_NEW_API_USERNAME=
# 可选/敏感：New API 数据端用户 Token；不是模型调用 Token。
UCLAW_TEST_NEW_API_TOKEN=
# 可选：License 测试服务 HTTPS 地址。
UCLAW_TEST_LICENSE_URL=
# 可选：License 验签公钥文件绝对路径；禁止填私钥。
UCLAW_TEST_LICENSE_PUBLIC_KEY_PATH=

# 可选：发行版更新 Feed HTTPS 地址。
UCLAW_TEST_RELEASE_FEED_URL=
# 可选：发行包验签公钥文件绝对路径；禁止填私钥。
UCLAW_TEST_RELEASE_PUBLIC_KEY_PATH=

# 严禁写入本文件或 .env：License/Release 签名私钥、企业上游 Key、
# New API 后台管理 Key、个人微信二维码/会话凭据、正式生产账号凭据。
