# U-Claw development integration template.
# Copy values only into local .env. Never commit secrets.

# Production desktop wiring. Required for a real Electron run.
UCLAW_DESKTOP_WIRING_MODULE=

# OpenClaw runtime and portable data paths.
UCLAW_RUNTIME_DIR=
UCLAW_DATA_DIR=
UCLAW_CACHE_DIR=

# Renderer development URL. Production packaging does not use this value.
UCLAW_RENDERER_URL=http://127.0.0.1:4174

# Existing plugin registry endpoint. Leave empty when plugin registry is not under test.
UCLAW_PLUGIN_REGISTRY_URL=

# Network proxy used by desktop probes and provider executors.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost

# The UCLAW_TEST_* values below are reserved for P4 integration harnesses.
# Current production code does not read them until the matching P4 task lands.

# OpenClaw/Gateway integration target.
UCLAW_TEST_OPENCLAW_GATEWAY_URL=
UCLAW_TEST_OPENCLAW_GATEWAY_TOKEN=
UCLAW_TEST_OPENCLAW_CLI_PATH=

# Domestic or OpenAI-compatible provider test account.
UCLAW_TEST_PROVIDER_BASE_URL=
UCLAW_TEST_PROVIDER_API_KEY=
UCLAW_TEST_PROVIDER_MODEL=

# Optional local model endpoints.
UCLAW_TEST_OLLAMA_URL=http://127.0.0.1:11434
UCLAW_TEST_LM_STUDIO_URL=http://127.0.0.1:1234

# SkillHub, plugin registry, and MCP test targets.
UCLAW_TEST_SKILLHUB_URL=https://skillhub.cn
UCLAW_TEST_PLUGIN_REGISTRY_URL=
UCLAW_TEST_MCP_HTTP_URL=

# Channel test credentials. Use dedicated non-production accounts.
UCLAW_TEST_TELEGRAM_BOT_TOKEN=
UCLAW_TEST_TELEGRAM_CHAT_ID=
UCLAW_TEST_QQ_APP_ID=
UCLAW_TEST_QQ_APP_SECRET=
UCLAW_TEST_FEISHU_APP_ID=
UCLAW_TEST_FEISHU_APP_SECRET=
UCLAW_TEST_WECOM_CORP_ID=
UCLAW_TEST_WECOM_AGENT_ID=
UCLAW_TEST_WECOM_SECRET=
UCLAW_TEST_DISCORD_BOT_TOKEN=
UCLAW_TEST_DISCORD_CHANNEL_ID=

# Third-stage service integration. Client-side test credentials only.
UCLAW_TEST_NEW_API_MANAGEMENT_URL=
UCLAW_TEST_NEW_API_DATA_URL=
UCLAW_TEST_NEW_API_USERNAME=
UCLAW_TEST_NEW_API_TOKEN=
UCLAW_TEST_LICENSE_URL=
UCLAW_TEST_LICENSE_PUBLIC_KEY_PATH=

# Release verification target. Public verification key only.
UCLAW_TEST_RELEASE_FEED_URL=
UCLAW_TEST_RELEASE_PUBLIC_KEY_PATH=

# Forbidden here: License/Release signing private keys, enterprise upstream
# provider keys, personal WeChat QR/session data, or production credentials.
