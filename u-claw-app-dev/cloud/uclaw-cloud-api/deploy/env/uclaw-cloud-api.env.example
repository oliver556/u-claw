APP_ENV=production
UCLAW_HTTP_ADDR=127.0.0.1:8080

DATABASE_URL=postgres://uclaw:change-me@127.0.0.1:5432/uclaw_cloud?sslmode=disable
JWT_SECRET=change-me-at-least-32-bytes
ADMIN_TOKEN=change-me-at-least-32-bytes
ADMIN_ENCRYPTION_KEY=change-me-at-least-32-bytes
SMS_CODE_PEPPER=change-me-at-least-32-bytes
ACTIVATION_CODE_PEPPER=change-me-at-least-32-bytes
AUTH_TOKEN_TTL=24h
# Current acceptance build may use fixed while Aliyun SMS approval is pending.
# Set SMS_PROVIDER=aliyun after SMS delivery is approved.
SMS_PROVIDER=aliyun
DEV_SMS_CODE=123456

NEWAPI_ADMIN_BASE_URL=https://newapi-admin.example.com
NEWAPI_ADMIN_TOKEN=change-me
NEWAPI_ADMIN_USERNAME=change-me
NEWAPI_ADMIN_PASSWORD=change-me
NEWAPI_CLIENT_BASE_URL=https://api.yiyong.me/v1
NEWAPI_PREVIEW_TOKEN=replace-with-real-token-response-after-newapi-token-spike
NEWAPI_HTTP_TIMEOUT=10s
NEWAPI_TOKEN_NAME=uclaw-main
NEWAPI_ACTIVATION_QUOTA=100000
NEWAPI_USER_PASSWORD_SECRET=change-me-at-least-32-bytes
# Optional acceptance-only issuer for startup hard-update credentials.
# File must be root-only 0600 and include binding constraints; never place deviceToken in this env file.
UPDATE_CREDENTIAL_FILE=

ALIYUN_SMS_ACCESS_KEY_ID=change-me
ALIYUN_SMS_ACCESS_KEY_SECRET=change-me
ALIYUN_SMS_SIGN_NAME=Bavi-box
ALIYUN_SMS_TEMPLATE_CODE=SMS_000000000
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_TEMPLATE_PARAM_NAME=code
ALIYUN_SMS_HTTP_TIMEOUT=3s

WECHAT_PAY_MCH_ID=change-me
WECHAT_PAY_APP_ID=change-me
WECHAT_PAY_API_V3_KEY=change-me
WECHAT_PAY_PRIVATE_KEY_PATH=/etc/uclaw-cloud-api/wechatpay_private_key.pem
WECHAT_PAY_CERT_SERIAL_NO=change-me

ALIPAY_APP_ID=change-me
ALIPAY_PRIVATE_KEY_PATH=/etc/uclaw-cloud-api/alipay_private_key.pem
ALIPAY_PUBLIC_CERT_PATH=/etc/uclaw-cloud-api/alipay_public_cert.pem
ALIPAY_SPI_MERCHANT_ID=change-me
ALIPAY_SPI_MERCHANT_NAME=Bavi-box
ALIPAY_SPI_MERCHANT_SHORT=Bavi
ALIPAY_SPI_SERVICE_PHONE=0571-00000000
ALIPAY_SPI_SERVICE_ADDRESS=https://license.yiyong.me
# Optional: if unset, SPI signing reuses ALIPAY_PRIVATE_KEY_PATH.
ALIPAY_SPI_PRIVATE_KEY_PATH=/etc/uclaw-cloud-api/alipay_private_key.pem
