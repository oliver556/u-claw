NEWAPI_IMAGE=calciumion/new-api:latest
SUB2API_IMAGE=weishaw/sub2api:latest
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

NEWAPI_HOST_BIND=0.0.0.0
NEWAPI_HTTP_PORT=3000
SUB2API_HOST_BIND=0.0.0.0
SUB2API_HTTP_PORT=8080
SUB2API_SERVER_MODE=release
SUB2API_RUN_MODE=standard
SUB2API_ADMIN_EMAIL=admin@sub2api.local
SUB2API_ADMIN_PASSWORD=change-me-at-least-12-bytes

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=uclaw_stack
POSTGRES_PASSWORD=change-me-at-least-32-bytes
POSTGRES_BOOTSTRAP_DB=postgres
NEWAPI_DB=oneapi
SUB2API_DB=sub2api

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-at-least-32-bytes
NEWAPI_REDIS_DB=0
SUB2API_REDIS_DB=1

NEWAPI_SESSION_SECRET=change-me-at-least-32-bytes
NEWAPI_CRYPTO_SECRET=change-me-at-least-32-bytes
SUB2API_JWT_SECRET=change-me-at-least-32-bytes
SUB2API_TOTP_ENCRYPTION_KEY=change-me-64-hex-chars
