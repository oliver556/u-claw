[Unit]
Description=U-Claw Cloud API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uclaw
Group=uclaw
WorkingDirectory=/opt/uclaw-cloud-api/current
EnvironmentFile=/etc/uclaw-cloud-api/uclaw-cloud-api.env
ExecStart=/opt/uclaw-cloud-api/current/bin/uclaw-cloud-api serve
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
