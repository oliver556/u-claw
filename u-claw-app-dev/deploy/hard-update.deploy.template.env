# U-Claw hard update deploy placeholders.
# Fill locally or in CI secret store. Do not commit real values.

UCLAW_PRODUCTION_URL=https://yiyong.me/uclaw/releases/production.json
UCLAW_RELEASES_BASE_URL=https://yiyong.me/uclaw/releases

R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STAGING_BUCKET=u-claw-updates-staging
R2_STAGING_PUBLIC_URL=https://pub-8289f643846848528b61bfd5dbf17e43.r2.dev
R2_PROD_BUCKET=u-claw-updates-prod
R2_PROD_PUBLIC_URL=https://pub-4f24fbbe718b4c75955440700c70bdeb.r2.dev

# Legacy aliases still accepted by scripts/hard-update-upload-r2.js.
CLOUDFLARE_ACCOUNT_ID=
UCLAW_R2_BUCKET=
UCLAW_R2_ENDPOINT=
UCLAW_R2_ACCESS_KEY_ID=
UCLAW_R2_SECRET_ACCESS_KEY=
UCLAW_R2_PUBLIC_URL=

# Optional Worker / route deploy.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
UCLAW_WORKER_NAME=
UCLAW_RELEASES_ROUTE=yiyong.me/uclaw/releases/*

# Server placeholders. Never write passwords here.
ALIYUN_LICENSE_API_BASE=
ALIYUN_DEPLOY_HOST=
HK_VIDEO_ADAPTER_HOST=
UCLAW_UPDATE_CHECK_PORT=18080
UCLAW_UPDATE_RELEASE_ROOT=/opt/uclaw-update/release
UCLAW_UPDATE_PUBLIC_BASE_URL=
UCLAW_UPDATE_AUTH_MODE=permissive
# For real staging/prod auth, point to an existing server-side env file that contains DATABASE_URL.
# Do not copy DATABASE_URL into git or client packages.
UCLAW_UPDATE_DATABASE_ENV_FILE=
UCLAW_UPDATE_DATABASE_URL_FILE=
UCLAW_UPDATE_DATABASE_URL=
# Optional local Postgres access for root-owned control plane on the same VPS.
UCLAW_UPDATE_PSQL_DATABASE=
UCLAW_UPDATE_PSQL_SYSTEM_USER=
UCLAW_UPDATE_PSQL_USER=
UCLAW_UPDATE_PSQL_HOST=
UCLAW_UPDATE_PSQL_PORT=
UCLAW_SHORT_TOKEN_SECRET=

# Signing. Real private key path must be local ignored storage or secret manager.
UCLAW_RELEASE_KEY_ID=uclaw-release-2026-08-28
UCLAW_RELEASE_PRIVATE_KEY_PATH=
UCLAW_RELEASE_PUBLIC_KEYS_PATH=
