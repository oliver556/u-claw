# U-Claw hard update deploy placeholders.
# Fill locally or in CI secret store. Do not commit real values.

UCLAW_PRODUCTION_URL=https://yiyong.me/uclaw/releases/production.json
UCLAW_RELEASES_BASE_URL=https://yiyong.me/uclaw/releases

CLOUDFLARE_ACCOUNT_ID=
UCLAW_R2_BUCKET=
UCLAW_R2_ENDPOINT=
UCLAW_R2_ACCESS_KEY_ID=
UCLAW_R2_SECRET_ACCESS_KEY=

# Optional Worker / route deploy.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
UCLAW_WORKER_NAME=
UCLAW_RELEASES_ROUTE=yiyong.me/uclaw/releases/*

# Server placeholders. Never write passwords here.
ALIYUN_LICENSE_API_BASE=
ALIYUN_DEPLOY_HOST=
HK_VIDEO_ADAPTER_HOST=

# Signing. Real private key path must be local ignored storage or secret manager.
UCLAW_RELEASE_KEY_ID=uclaw-release-2026-01
UCLAW_RELEASE_PRIVATE_KEY_PATH=
UCLAW_RELEASE_PUBLIC_KEYS_PATH=
